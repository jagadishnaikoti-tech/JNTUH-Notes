# ---------------------------------------------------------------------------
# Firebase web (client) configuration for JNTUH Notes.
#
# Copy this file to `.env.local` (git-ignored) and fill in the real values, or
# add the same keys in your Vercel project settings (Environment Variables).
#
# IMPORTANT
# - The Firebase *web* config below is public by design: it ships inside the
#   browser bundle and is NOT a secret. It cannot be used to bypass Firestore
#   security rules.
# - NEVER put Firebase Admin SDK credentials (service-account JSON) or private
#   keys in this file or anywhere under src/. The first administrator is
#   provisioned with a local Admin SDK script - see docs/ADMIN_SETUP.md.
# ---------------------------------------------------------------------------

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Set to "true" to require explicit visitor consent before ANY analytics runs
# (recommended for EEA/UK audiences under GDPR/ePrivacy). Default: false.
VITE_REQUIRE_CONSENT=false
