rules_version = '2';

// ===========================================================================
// JNTUH Notes - Cloud Firestore security rules
//
// Threat model
//   * Visitors are anonymous and may only CREATE validated analytics events.
//     They can never read other visitors' events, update or delete anything.
//   * Only an authenticated administrator may read analytics or manage
//     channels, alerts and settings. "Administrator" means a Firebase Auth user
//     carrying the custom claim `admin == true`. Creating an account never
//     grants this - the claim is set out-of-band with the Admin SDK (see
//     scripts/set-admin.mjs).
//   * Alert Radar visitors may read PUBLISHED alerts only; every alert write
//     (create/update/publish/unpublish/delete) is admin-only.
//   * Daily aggregates are written only by a trusted backend; the client can
//     never write them.
//
// Deploy with:  firebase deploy --only firestore:rules
// ===========================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers -----------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    // Server-enforced administrator check. Never trust the client UI alone.
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isString(v, maxLen) {
      return v is string && v.size() <= maxLen;
    }

    // ---- analyticsEvents/{eventId} ----------------------------------------
    // Append-only, anonymous, validated event stream. This is the dashboard's
    // source of truth.

    function validEvent(d) {
      return d.keys().hasOnly([
          'type', 'path', 'title', 'docId', 'docTitle', 'subject', 'yearId',
          'yearName', 'action', 'sourcePath', 'sourceTitle', 'visitorId',
          'sessionId', 'ts', 'tsClient'
        ])
        && d.keys().hasAll(['type', 'visitorId', 'sessionId', 'ts'])
        && d.type in ['page_view', 'pdf_click']
        && isString(d.visitorId, 100) && d.visitorId.size() >= 8
        && isString(d.sessionId, 100) && d.sessionId.size() >= 8
        && d.ts is timestamp
        // page_view must reference a path
        && (d.type != 'page_view' || isString(d.path, 300))
        // pdf_click must reference a document and a known action
        && (d.type != 'pdf_click' || (isString(d.docId, 250)
              && d.action in ['open', 'view', 'download']));
    }

    match /analyticsEvents/{eventId} {
      allow create: if validEvent(request.resource.data);
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ---- analyticsDaily/{date} --------------------------------------------
    // Rollups produced by a trusted backend only.

    match /analyticsDaily/{date} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---- channels/{channelId} ---------------------------------------------
    // Public visitors may read ACTIVE channels only (their query filters
    // `active == true`); administrators manage everything.

    function validChannel(d) {
      return d.keys().hasOnly(['name', 'url', 'icon', 'active', 'order', 'createdAt', 'updatedAt'])
        && isString(d.name, 80) && d.name.size() >= 1
        && isString(d.url, 500) && (d.url.matches('^https?://.+'))
        && isString(d.icon, 40)
        && d.active is bool
        && d.order is number;
    }

    match /channels/{channelId} {
      allow read: if isAdmin() || resource.data.active == true;
      allow create, update: if isAdmin() && validChannel(request.resource.data);
      allow delete: if false;
    }

    // ---- alerts/{alertId} --------------------------------------------------
    // JNTUH Alert Radar. Public visitors may read PUBLISHED alerts only, and
    // their query MUST filter `status == "published"` (the rules require it).
    // Administrators manage everything and are the only writers, so the
    // verification metadata (verifiedAt / verifiedBy) can never be set or
    // altered by an unprivileged user.

    function validAlert(d) {
      return d.keys().hasOnly([
          'title', 'summary', 'category', 'sourceName', 'sourceUrl',
          'publishedAt', 'deadlineAt', 'status', 'pinned', 'audience', 'tags',
          'verifiedAt', 'verifiedBy', 'createdBy', 'updatedBy', 'createdAt',
          'updatedAt', 'schemaVersion'
        ])
        && d.keys().hasAll([
          'title', 'summary', 'category', 'sourceUrl', 'status', 'pinned',
          'createdBy', 'updatedBy', 'createdAt', 'updatedAt', 'schemaVersion'
        ])
        && isString(d.title, 200) && d.title.size() >= 3
        && isString(d.summary, 600) && d.summary.size() >= 1
        && d.category in ['exams', 'timetable', 'calendar', 'results',
              'admissions', 'scholarship', 'deadline', 'general']
        && isString(d.sourceName, 80)
        && isString(d.sourceUrl, 500) && d.sourceUrl.matches('^https?://.+')
        && d.status in ['draft', 'published']
        && d.pinned is bool
        && d.schemaVersion is number
        && d.createdAt is timestamp && d.updatedAt is timestamp
        && isString(d.createdBy, 200) && isString(d.updatedBy, 200)
        && (!d.keys().hasAny(['publishedAt']) || d.publishedAt == null
              || d.publishedAt is timestamp)
        && (!d.keys().hasAny(['deadlineAt']) || d.deadlineAt == null
              || d.deadlineAt is timestamp)
        && (!d.keys().hasAny(['verifiedAt']) || d.verifiedAt == null
              || d.verifiedAt is timestamp)
        && (!d.keys().hasAny(['verifiedBy']) || isString(d.verifiedBy, 200))
        // Hardening: a PUBLISHED alert must carry verification metadata -
        // verifiedAt is a real timestamp and verifiedBy a non-empty actor.
        // verifyAlert() is the only writer of these fields; publishing never
        // stamps them (src/lib/alerts.js publishAlert refuses instead).
        && (d.status != 'published'
              || (d.keys().hasAll(['verifiedAt', 'verifiedBy'])
                    && d.verifiedAt is timestamp
                    && isString(d.verifiedBy, 200) && d.verifiedBy.size() >= 1))
        && (!d.keys().hasAny(['audience']) || d.audience is list)
        && (!d.keys().hasAny(['tags']) || d.tags is list);
    }

    match /alerts/{alertId} {
      allow read: if isAdmin() || resource.data.status == 'published';
      allow create, update: if isAdmin() && validAlert(request.resource.data);
      allow delete: if false;
    }

    // ---- ingestItems/{itemId} ---------------------------------------------
    // JNTUH Alert Radar STAGING (Phase 2). These documents are written ONLY by
    // the trusted collector through the Admin SDK, which bypasses these rules.
    // A client may never create an item, because the collector owns the item's
    // identity and every notice-derived field (title, URLs, hashes, source ids
    // and the collector timestamps). The single client mutation permitted is an
    // administrator moving a staged item through the review state machine.

    // The only fields an administrator may change on a staged item. Everything
    // else in the document is immutable from the client side.
    function reviewUpdateFields() {
      return ['reviewState', 'promotedAlertId', 'promotedAt', 'promotedBy'];
    }

    // Promotion metadata is all-or-nothing. A `promoted` item must carry a
    // well-formed alert id, timestamp and actor. Any other state may *keep* a
    // previous promotion's metadata as history, but every present field must
    // still be correctly typed (no dumping a map or a number in `promotedAt`).
    function validPromotion(d) {
      return d.reviewState == 'promoted'
        ? (d.keys().hasAll(['promotedAlertId', 'promotedAt', 'promotedBy'])
            && isString(d.promotedAlertId, 200) && d.promotedAlertId.size() >= 1
            && d.promotedAt is timestamp
            && isString(d.promotedBy, 200) && d.promotedBy.size() >= 1)
        : ((!d.keys().hasAny(['promotedAlertId']) || d.promotedAlertId == null
              || (isString(d.promotedAlertId, 200) && d.promotedAlertId.size() >= 1))
            && (!d.keys().hasAny(['promotedAt']) || d.promotedAt == null
              || d.promotedAt is timestamp)
            && (!d.keys().hasAny(['promotedBy']) || d.promotedBy == null
              || (isString(d.promotedBy, 200) && d.promotedBy.size() >= 1)));
    }

    function validReviewUpdate(d, existing) {
      return d.diff(existing).affectedKeys().hasOnly(reviewUpdateFields())
        && d.keys().hasAll(['reviewState'])
        && d.reviewState in ['new', 'promoted', 'ignored']
        && validPromotion(d);
    }

    match /ingestItems/{itemId} {
      allow read: if isAdmin();
      allow create: if false;   // the collector is the only creator
      allow update: if isAdmin() && validReviewUpdate(request.resource.data, resource.data);
      allow delete: if false;
    }

    // ---- ingestRuns/{runId} -----------------------------------------------
    // One audit document per collector run (status, counters, source summary).
    // Written only by the collector; administrators may read the audit trail.

    match /ingestRuns/{runId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---- ingestSourceHealth/{sourceId} ------------------------------------
    // Rolling per-source health (consecutive failures, last notices, error).
    // Written only by the collector; administrators may read it.

    match /ingestSourceHealth/{sourceId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---- settings/{docId} --------------------------------------------------
    // Public website settings. Only the `public` document is world-readable.

    match /settings/public {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- users/{uid} -------------------------------------------------------
    // Optional student profile document (display name, email, timestamps).
    // Authorization NEVER reads from here - the `admin` custom claim is
    // authoritative. These rules let a student maintain only their own display
    // name, and prevent privilege escalation through document fields.

    function validProfileCreate(d) {
      return d.keys().hasOnly(['displayName', 'email', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['displayName'])
        && isString(d.displayName, 120)
        && (!d.keys().hasAny(['email']) || isString(d.email, 200));
    }

    function validProfileUpdate(d, existing) {
      return d.diff(existing).affectedKeys().hasOnly(['displayName', 'email', 'updatedAt'])
        && isString(d.displayName, 120)
        && (!d.keys().hasAny(['email']) || isString(d.email, 200));
    }

    match /users/{uid} {
      allow read: if (isSignedIn() && request.auth.uid == uid) || isAdmin();
      allow create: if isSignedIn() && request.auth.uid == uid
        && validProfileCreate(request.resource.data);
      allow update: if isSignedIn() && request.auth.uid == uid
        && validProfileUpdate(request.resource.data, resource.data);
      allow delete: if false;
      // Administrators retain full access to every profile.
      allow write: if isAdmin();
    }

    // Everything else is denied by default.
  }
}
