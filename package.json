{
  "name": "jntuh-notes",
  "private": true,
  "version": "1.0.0",
  "description": "JNTUH Notes - React (Vite) study-material website for B.Tech CSE & AIML (R22): subject notes, question sets and previous papers linked to their original documents.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/gen-seo.mjs",
    "preview": "vite preview",
    "seo": "node scripts/gen-seo.mjs",
    "collector": "node collector/index.mjs",
    "collector:schedule": "node collector/scheduledRun.mjs",
    "test:collector": "node --test \"collector/tests/*.test.mjs\"",
    "test:unit": "node --test \"tests/*.test.mjs\"",
    "test:rules": "firebase --config firebase.e2e.json emulators:exec --only firestore --project demo-jntuh-notes \"node --test --test-concurrency=1 collector/tests/rules/firestore.rules.test.mjs collector/tests/rules/staging.rules.test.mjs collector/tests/rules/ingest.promotion.rules.test.mjs collector/tests/rules/ingest.e2e.rules.test.mjs collector/tests/rules/collector.staging.rules.test.mjs\"",
    "admin:create": "node scripts/create-admin.mjs",
    "admin:grant": "node scripts/set-admin.mjs",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes --project jntuh-notes-6ef74",
    "deploy:rules:staging": "firebase --config firebase.staging.json deploy --only firestore:rules,firestore:indexes --project jntuh-notes-staging"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@vitejs/plugin-react": "^4.3.3",
    "firebase-admin": "^14.5.0",
    "vite": "^5.4.10"
  }
}
